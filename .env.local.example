# TshirtSolution — environment
# Copy to .env.local and fill in your Supabase project values.
# Get them from Supabase Dashboard -> Project Settings -> API.
#
# The anon/public key and URL are safe to expose (RLS protects data).
# The service_role key is SECRET — keep it out of the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
